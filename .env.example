# Copy to .env and fill in. Every network-specific value lives here (never in code or
# compose files), so the same images run on a dev machine and on TrueNAS.

# --- Database (TimescaleDB container) ---
POSTGRES_USER=netmap
POSTGRES_PASSWORD=change-me
POSTGRES_DB=netmap

# --- Your network ---
# LAN subnet to discover devices in (and to draw fake device IPs from when seeding).
NETMAP_LAN_CIDR=192.168.1.0/24
# Interface on that subnet for ARP discovery. Leave blank to pick it automatically.
NETMAP_LAN_IFACE=
# Seconds between ARP sweeps, and how long a device can stay silent before it's offline.
NETMAP_ARP_SWEEP_INTERVAL_SECONDS=120
NETMAP_DEVICE_OFFLINE_AFTER_SECONDS=600
# Days between downloads of the IEEE MAC vendor registry (a snapshot ships in the image).
NETMAP_OUI_REFRESH_DAYS=7
# Seconds between hostname discovery rounds (mDNS, SSDP, NetBIOS, reverse DNS queries).
NETMAP_NAMES_INTERVAL_SECONDS=300
# Which source names a device when several do, best first (dhcp, mdns, ssdp, netbios, rdns).
NETMAP_HOSTNAME_PRECEDENCE=ssdp,mdns,dhcp,netbios,rdns
# Seconds before an online device's ports are scanned again (0 turns scanning off).
NETMAP_PORT_SCAN_INTERVAL_SECONDS=21600
# Seconds between reads of the router's UPnP port mappings.
NETMAP_UPNP_POLL_INTERVAL_SECONDS=300
# DNS server for reverse lookups of device IPs. Blank: the Pi-hole host, else the system resolver.
NETMAP_RDNS_SERVER=
# Pi-hole v6 URL and app password (Settings > Web interface / API > Configure app password).
NETMAP_PIHOLE_URL=http://pi.hole
NETMAP_PIHOLE_PASSWORD=
# Seconds between query log reads; set false if NETMAP_PIHOLE_URL is https with Pi-hole's
# self-signed certificate.
NETMAP_PIHOLE_POLL_SECONDS=15
NETMAP_PIHOLE_VERIFY_TLS=true
# Free GeoLite2 license key from maxmind.com, for the country and network of the IPs
# domains resolve to. Optional: without it the free DB-IP Lite databases are used.
NETMAP_MAXMIND_LICENSE_KEY=
# Days before the MaxMind databases are downloaded again (DB-IP's update monthly).
NETMAP_GEOIP_REFRESH_DAYS=7
# Free abuse.ch Auth-Key (sign up at auth.abuse.ch) to also match domains against the
# URLhaus and ThreatFox blocklists. FireHOL level1 and Feodo Tracker need no key.
NETMAP_ABUSECH_AUTH_KEY=
# Hours before each blocklist is downloaded again.
NETMAP_BLOCKLIST_REFRESH_HOURS=24
# Days a device's normal behavior is learned for, from its first DNS lookup. New sites,
# organizations, countries and networks after that are recorded in its history.
NETMAP_BASELINE_LEARNING_DAYS=7
# An IoT device online this many hours with fewer DNS lookups through Pi-hole than
# NETMAP_DNS_BYPASS_MIN_LOOKUPS probably uses its own DNS server. 0 lookups turns it off.
NETMAP_DNS_BYPASS_HOURS=24
NETMAP_DNS_BYPASS_MIN_LOOKUPS=10
# Apprise URLs to send alerts to (ntfy, Discord, email, ...; see github.com/caronc/apprise),
# separated by spaces or commas. Blank keeps alerts in the app only.
NETMAP_APPRISE_URLS=
# Most notifications sent an hour; later alerts wait and go out together.
NETMAP_NOTIFY_MAX_PER_HOUR=10
# The app's address from your phone (e.g. http://nas:8000), for links in notifications.
NETMAP_PUBLIC_URL=
# Password for the web UI and API. Blank leaves both open to anyone on the LAN.
NETMAP_ADMIN_PASSWORD=
# Days a login lasts.
NETMAP_SESSION_DAYS=30
# Reverse proxies to trust for X-Forwarded-For/-Proto (comma separated IPs or CIDRs), when
# serving the UI over HTTPS through one. Blank trusts none (only the container itself).
NETMAP_TRUSTED_PROXIES=

# --- Backups (server stack: a dump into <NETMAP_DATA_DIR>/backups) ---
NETMAP_BACKUP_INTERVAL_HOURS=24
# How many dumps to keep; older ones are deleted.
NETMAP_BACKUP_KEEP=14

# --- Critical devices (cameras, locks: mark them on the device page) ---
# Minutes unheard before a critical device's alert (each device can override it), and hours
# between reminders while it stays down (0: just once).
NETMAP_CRITICAL_GRACE_MINUTES=5
NETMAP_CRITICAL_REMIND_HOURS=12

# --- Traffic capture (optional; docs/span.md) ---
# Runs in the "capture" service: COMPOSE_PROFILES=capture. The NIC that receives a switch's
# mirror (SPAN) port, with no IP address on it:
NETMAP_CAPTURE_INTERFACE=
# And/or the UDP port to receive NetFlow v5/v9 or IPFIX on (e.g. 2055), from OPNsense, ...
NETMAP_NETFLOW_PORT=
# Packet captures of one device from the UI: largest size (MB) and length (minutes), and
# how many are kept.
NETMAP_PCAP_MAX_MB=100
NETMAP_PCAP_MAX_MINUTES=60
NETMAP_PCAP_KEEP=10
# A device sending more than this many MB to the internet in an hour, and this many times
# what it received, raises an "upload-heavy" alert.
NETMAP_UPLOAD_HEAVY_MB=500
NETMAP_UPLOAD_HEAVY_RATIO=4

# --- Device fingerprinting (optional) ---
# Fingerbank API key (free at fingerbank.org): names devices from their DHCP fingerprint.
NETMAP_FINGERBANK_API_KEY=

# --- Wi-Fi access points (optional) ---
# A UniFi Network controller (a local "View Only" account is enough). Self-signed
# certificate: NETMAP_UNIFI_VERIFY_TLS=false.
NETMAP_UNIFI_URL=
NETMAP_UNIFI_USERNAME=
NETMAP_UNIFI_PASSWORD=
NETMAP_UNIFI_SITE=default
# And/or OpenWrt APs (comma-separated URLs, sharing one login; needs uhttpd-mod-ubus).
NETMAP_OPENWRT_URLS=
NETMAP_OPENWRT_USERNAME=root
NETMAP_OPENWRT_PASSWORD=

# --- Prometheus (optional) ---
# Bearer token for /metrics; unset, /metrics needs a login like the API.
NETMAP_METRICS_TOKEN=

# --- Data retention (days) ---
NETMAP_RAW_RETENTION_DAYS=30
NETMAP_AGG_1H_RETENTION_DAYS=90
NETMAP_AGG_1D_RETENTION_DAYS=365
NETMAP_COMPRESS_AFTER_DAYS=2

# --- Host ports published by docker compose ---
NETMAP_API_PUBLISH_PORT=8000
NETMAP_WEB_PUBLISH_PORT=5173
# DB is published on loopback only, for local tools and tests.
NETMAP_DB_PUBLISH_PORT=5433

# --- Server stack only (deploy/portainer-compose.yml) ---
# Host path of the project dataset; the DB lives in <this>/db. Not used by the dev stack.
NETMAP_DATA_DIR=/mnt/<pool>/<dataset>/network_mapper

NETMAP_LOG_LEVEL=INFO
