# Copy to .env and fill in. Every network-specific value lives here (never in code or
# compose files), so the same images run on a dev machine and on TrueNAS.

# --- Database (TimescaleDB container) ---
POSTGRES_USER=netmap
POSTGRES_PASSWORD=change-me
POSTGRES_DB=netmap

# --- Your network ---
# LAN subnet to discover devices in (and to draw fake device IPs from when seeding).
NETMAP_LAN_CIDR=192.168.1.0/24
# Interface on that subnet for ARP discovery. Leave blank to pick it automatically.
NETMAP_LAN_IFACE=
# Seconds between ARP sweeps, and how long a device can stay silent before it's offline.
NETMAP_ARP_SWEEP_INTERVAL_SECONDS=120
NETMAP_DEVICE_OFFLINE_AFTER_SECONDS=600
# Days between downloads of the IEEE MAC vendor registry (a snapshot ships in the image).
NETMAP_OUI_REFRESH_DAYS=7
# Seconds between hostname discovery rounds (mDNS, SSDP, NetBIOS, reverse DNS queries).
NETMAP_NAMES_INTERVAL_SECONDS=300
# Which source names a device when several do, best first (dhcp, mdns, ssdp, netbios, rdns).
NETMAP_HOSTNAME_PRECEDENCE=ssdp,mdns,dhcp,netbios,rdns
# Seconds before an online device's ports are scanned again (0 turns scanning off).
NETMAP_PORT_SCAN_INTERVAL_SECONDS=21600
# Seconds between reads of the router's UPnP port mappings.
NETMAP_UPNP_POLL_INTERVAL_SECONDS=300
# DNS server for reverse lookups of device IPs. Blank: the Pi-hole host, else the system resolver.
NETMAP_RDNS_SERVER=
# Pi-hole admin URL and app password (Settings > Web interface / API > App password). Used from M2.
NETMAP_PIHOLE_URL=http://pi.hole
NETMAP_PIHOLE_PASSWORD=
# Free GeoLite2 license key from maxmind.com. Used from M3; optional.
NETMAP_MAXMIND_LICENSE_KEY=
# Web UI admin password. Used from M4.
NETMAP_ADMIN_PASSWORD=

# --- Data retention (days) ---
NETMAP_RAW_RETENTION_DAYS=30
NETMAP_AGG_1H_RETENTION_DAYS=90
NETMAP_AGG_1D_RETENTION_DAYS=365
NETMAP_COMPRESS_AFTER_DAYS=2

# --- Host ports published by docker compose ---
NETMAP_API_PUBLISH_PORT=8000
NETMAP_WEB_PUBLISH_PORT=5173
# DB is published on loopback only, for local tools and tests.
NETMAP_DB_PUBLISH_PORT=5433

# --- Server stack only (deploy/portainer-compose.yml) ---
# Host path of the project dataset; the DB lives in <this>/db. Not used by the dev stack.
NETMAP_DATA_DIR=/mnt/<pool>/<dataset>/network_mapper

NETMAP_LOG_LEVEL=INFO
